{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ssc-notebox-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ssc-notebox-db",
      "database_id": "ssc-notebox-db-placeholder"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "ssc-notebox-files"
    }
  ]
}
