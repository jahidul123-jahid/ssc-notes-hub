# SSC Notes Hub — Environment Configuration

# 1. Supabase Backend Configuration (Recommended for multi-device live file sharing)
# Get from Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. Firebase Backend Configuration (Optional/Alternative)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Website Owner UID & Admin Security (Owner: Jahidul Islam)
VITE_OWNER_UID=your_verified_firebase_auth_uid
VITE_OWNER_EMAIL=jahidulislam@sscnoteshub.com
